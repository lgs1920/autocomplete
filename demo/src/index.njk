                <p class="section-intro">Searches <a href="https://countries.dev/">countries.dev</a> by name and submits the selected ISO alpha-2 country code.</p>
                <wa-button appearance="outlined" size="s" data-dialog="open country-form-example-dialog">View example code</wa-button>
                <wa-dialog id="country-form-example-dialog" class="example-code-dialog" label="Example code: Submit a country code" with-footer>
                    <wa-copy-button slot="header-actions" copy-label="Copy code" success-label="Copied" error-label="Copy failed"></wa-copy-button>
                    <p class="eyebrow">HTML</p>
                    <pre data-language="HTML"><code><span class="token-punctuation">&lt;</span><span class="token-tag">form</span> <span class="token-attribute">id</span>=<span class="token-attribute-value">"form-demo"</span><span class="token-punctuation">&gt;</span>
    <span class="token-punctuation">&lt;</span><span class="token-tag">lgs1920-autocomplete</span> <span class="token-attribute">id</span>=<span class="token-attribute-value">"form-autocomplete"</span> <span class="token-attribute">name</span>=<span class="token-attribute-value">"country-code"</span> <span class="token-attribute">label</span>=<span class="token-attribute-value">"Country"</span> <span class="token-attribute">min-chars</span>=<span class="token-attribute-value">"3"</span><span class="token-punctuation">&gt;&lt;/</span><span class="token-tag">lgs1920-autocomplete</span><span class="token-punctuation">&gt;</span>
    <span class="token-punctuation">&lt;</span><span class="token-tag">wa-button</span> <span class="token-attribute">type</span>=<span class="token-attribute-value">"submit"</span><span class="token-punctuation">&gt;</span>Submit country code<span class="token-punctuation">&lt;/</span><span class="token-tag">wa-button</span><span class="token-punctuation">&gt;</span>
<span class="token-punctuation">&lt;/</span><span class="token-tag">form</span><span class="token-punctuation">&gt;</span></code></pre>
                    <p class="eyebrow">JavaScript</p>
                    <pre data-language="JavaScript"><code><span class="token-keyword">const</span> field = document.querySelector(<span class="token-string">'#form-autocomplete'</span>)
field.searchOptions = <span class="token-keyword">async</span> (query, {signal}) <span class="token-operator">=&gt;</span> {
  <span class="token-keyword">const</span> endpoint = <span class="token-keyword">new</span> URL(<span class="token-string">`https://countries.dev/name/${encodeURIComponent(query.trim())}`</span>)
  endpoint.searchParams.set(<span class="token-string">'fields'</span>, <span class="token-string">'name,alpha2Code'</span>)
  endpoint.searchParams.set(<span class="token-string">'limit'</span>, String(field.maxResults))
  <span class="token-keyword">const</span> response = <span class="token-keyword">await</span> fetch(endpoint, {signal})
  <span class="token-keyword">if</span> (response.status === <span class="token-number">404</span>) <span class="token-keyword">return</span> []
  <span class="token-keyword">if</span> (!response.ok) <span class="token-keyword">throw</span> <span class="token-keyword">new</span> Error(<span class="token-string">'Country search failed'</span>)
  <span class="token-keyword">const</span> countries = <span class="token-keyword">await</span> response.json()
  <span class="token-keyword">return</span> countries.map(country <span class="token-operator">=&gt;</span> ({
    <span class="token-property">value</span>: country.alpha2Code,
    <span class="token-property">label</span>: country.name,
  }))
}

<span class="token-keyword">const</span> form = document.querySelector(<span class="token-string">'#form-demo'</span>)
form.addEventListener(<span class="token-string">'submit'</span>, event <span class="token-operator">=&gt;</span> {
  event.preventDefault()
  <span class="token-keyword">const</span> data = Object.fromEntries(<span class="token-keyword">new</span> FormData(event.currentTarget).entries())
  console.log(data)
})</code></pre>
