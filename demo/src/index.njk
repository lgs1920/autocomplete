        <span class="token-punctuation">&lt;</span><span class="token-tag">wa-option</span> <span class="token-attribute">value</span>=<span class="token-attribute-value">"paris"</span> <span class="token-attribute">data-icon</span>=<span class="token-attribute-value">"location-dot"</span> <span class="token-attribute">data-department</span>=<span class="token-attribute-value">"75"</span> <span class="token-attribute">data-region</span>=<span class="token-attribute-value">"Île-de-France"</span><span class="token-punctuation">&gt;</span>Paris<span class="token-punctuation">&lt;/</span><span class="token-tag">wa-option</span><span class="token-punctuation">&gt;</span>
        <span class="token-punctuation">&lt;</span><span class="token-tag">wa-option</span> <span class="token-attribute">value</span>=<span class="token-attribute-value">"reims"</span> <span class="token-attribute">data-icon</span>=<span class="token-attribute-value">"city"</span> <span class="token-attribute">data-department</span>=<span class="token-attribute-value">"51"</span> <span class="token-attribute">data-region</span>=<span class="token-attribute-value">"Grand Est"</span><span class="token-punctuation">&gt;</span>Reims<span class="token-punctuation">&lt;/</span><span class="token-tag">wa-option</span><span class="token-punctuation">&gt;</span>
