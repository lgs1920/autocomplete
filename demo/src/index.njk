            <article class="demo-card">
                <p class="eyebrow">Local options · HTML template</p>
                <h3>Render cities from a template</h3>
                {% raw %}<template id="city-option-template">
                    <wa-card class="template-city-card" appearance="outlined">
                        <strong>{{city}}</strong>
                        <small>{{region}} · {{country}}</small>
                    </wa-card>
                </template>{% endraw %}
                <lgs1920-autocomplete id="template-autocomplete" label="City" name="templateCity" option-template="city-option-template" placeholder="Search Paris, Reims, Lyon…" with-clear></lgs1920-autocomplete>
                <p class="section-intro">Type a city name to try the custom suggestion layout. Each option uses the HTML template below the field; select one to inspect its value and metadata.</p>
                <wa-details summary="View response">
                    <pre class="search-result" data-language="JSON" role="status" aria-live="polite"><code id="template-autocomplete-selection">Nothing selected</code></pre>
                </wa-details>
                <wa-button appearance="outlined" size="s" data-dialog="open template-example-dialog">View example code</wa-button>
                <wa-dialog id="template-example-dialog" class="example-code-dialog" label="Example code: HTML option template" with-footer>
                    <wa-copy-button slot="header-actions" copy-label="Copy code" success-label="Copied" error-label="Copy failed"></wa-copy-button>
                    <p class="eyebrow">HTML</p>
                    <pre data-language="HTML"><code>{% raw %}&lt;template id="city-option-template"&gt;
  &lt;wa-card appearance="outlined"&gt;
    &lt;strong&gt;{{city}}&lt;/strong&gt;
    &lt;small&gt;{{region}} · {{country}}&lt;/small&gt;
  &lt;/wa-card&gt;
&lt;/template&gt;

&lt;lgs1920-autocomplete id="template-autocomplete" label="City" name="templateCity" option-template="city-option-template"&gt;&lt;/lgs1920-autocomplete&gt;{% endraw %}</code></pre>
                    <p class="eyebrow">JavaScript</p>
                    <pre data-language="JavaScript"><code>const field = document.querySelector('#template-autocomplete')
field.options = [
  {value: 'paris', label: 'Paris', city: 'Paris', region: 'Île-de-France', country: 'France'},
  {value: 'reims', label: 'Reims', city: 'Reims', region: 'Grand Est', country: 'France'},
  {value: 'lyon', label: 'Lyon', city: 'Lyon', region: 'Auvergne-Rhône-Alpes', country: 'France'},
]</code></pre>
                    <footer slot="footer">
                        <wa-button appearance="filled" size="s" data-dialog="close">Close</wa-button>
                    </footer>
                </wa-dialog>
            </article>

            <article class="demo-card">
                <p class="eyebrow">Local options · Web Awesome brand colors</p>
                <h3>Choose a brand color</h3>
                <lgs1920-autocomplete id="brand-color-autocomplete" class="autocomplete-brand" label="Brand color" name="brandColor" size="s" appearance="filled-outlined" pill placeholder="Choose a brand color" with-clear>
                    <wa-icon slot="start" name="palette" aria-hidden="true"></wa-icon>
                </lgs1920-autocomplete>
                <p class="section-intro">Choose a standard Web Awesome brand hue to change the active brand for the whole demo. The field, suggestions, preview, and other brand-colored controls update together.</p>
                <div id="brand-color-preview" class="brand-color-preview" role="status" aria-live="polite">
                    <strong id="brand-color-preview-name">Choose a color to preview</strong>
                    <span>Background: <code>--wa-color-brand-fill-loud</code></span>
                    <span>Text: <code>--wa-color-brand-on-loud</code></span>
                </div>
                <wa-details id="brand-color-response-details" summary="View response" hidden>
                    <pre class="search-result" data-language="JSON" role="status" aria-live="polite"><code id="brand-color-autocomplete-selection">Nothing selected</code></pre>
                </wa-details>
                <wa-button appearance="outlined" size="s" data-dialog="open brand-color-example-dialog">View example code</wa-button>
                <wa-dialog id="brand-color-example-dialog" class="example-code-dialog" label="Example code: Choose a brand color" with-footer>
                    <wa-copy-button slot="header-actions" copy-label="Copy code" success-label="Copied" error-label="Copy failed"></wa-copy-button>
                    <p class="eyebrow">HTML</p>
                    <pre data-language="HTML"><code><span class="token-punctuation">&lt;</span><span class="token-tag">lgs1920-autocomplete</span> <span class="token-attribute">id</span>=<span class="token-attribute-value">"brand-color-autocomplete"</span> <span class="token-attribute">class</span>=<span class="token-attribute-value">"autocomplete-brand"</span> <span class="token-attribute">label</span>=<span class="token-attribute-value">"Brand color"</span> <span class="token-attribute">name</span>=<span class="token-attribute-value">"brandColor"</span> <span class="token-attribute">appearance</span>=<span class="token-attribute-value">"filled-outlined"</span> <span class="token-attribute">with-clear</span><span class="token-punctuation">&gt;</span>
  <span class="token-punctuation">&lt;</span><span class="token-tag">wa-icon</span> <span class="token-attribute">slot</span>=<span class="token-attribute-value">"start"</span> <span class="token-attribute">name</span>=<span class="token-attribute-value">"palette"</span> <span class="token-attribute">aria-hidden</span>=<span class="token-attribute-value">"true"</span><span class="token-punctuation">&gt;&lt;/</span><span class="token-tag">wa-icon</span><span class="token-punctuation">&gt;</span>
<span class="token-punctuation">&lt;/</span><span class="token-tag">lgs1920-autocomplete</span><span class="token-punctuation">&gt;</span>
<span class="token-punctuation">&lt;</span><span class="token-tag">div</span> <span class="token-attribute">id</span>=<span class="token-attribute-value">"brand-color-preview"</span> <span class="token-attribute">class</span>=<span class="token-attribute-value">"brand-color-preview"</span><span class="token-punctuation">&gt;</span>
  <span class="token-punctuation">&lt;</span><span class="token-tag">strong</span><span class="token-punctuation">&gt;</span>Selected brand hue<span class="token-punctuation">&lt;/</span><span class="token-tag">strong</span><span class="token-punctuation">&gt;</span>
  <span class="token-punctuation">&lt;/</span><span class="token-tag">div</span><span class="token-punctuation">&gt;</span>
</code></pre>
                    <p class="eyebrow">CSS</p>
                    <pre data-language="CSS"><code>.brand-color-preview {
  padding: var(--wa-space-l);
  border-radius: var(--wa-border-radius-l);
  background: var(--wa-color-surface-raised);
  color: var(--wa-color-text-normal);
}

.brand-color-preview--selected {
  background: var(--wa-color-brand-fill-loud);
  color: var(--wa-color-brand-on-loud);
}

.autocomplete-brand {
  color: var(--wa-color-brand-on-quiet);
  --wa-color-focus: var(--wa-color-brand-border-loud);
  --wa-form-control-label-color: var(--wa-color-brand-on-quiet);
  --wa-form-control-value-color: var(--wa-color-brand-on-quiet);
  /* Tint the suggestion panel with the current brand hue. */
  --lgs1920-autocomplete-panel-background: var(--wa-color-brand-fill-quiet);
  /* Keep panel messages legible on the brand surface. */
  --lgs1920-autocomplete-panel-color: var(--wa-color-brand-on-quiet);
  /* Mark the panel edge with a stronger brand tone. */
  --lgs1920-autocomplete-panel-border-color: var(--wa-color-brand-border-loud);
  /* Match regular option text to the quiet brand surface. */
  --lgs1920-autocomplete-option-color: var(--wa-color-brand-on-quiet);
  /* Give the keyboard-active option a stronger brand surface. */
  --lgs1920-autocomplete-option-active-background: var(--wa-color-brand-fill-normal);
  /* Keep pointer hover within the brand palette. */
  --lgs1920-autocomplete-option-hover-background: var(--wa-color-brand-fill-quiet);
  /* Use the loud brand fill for a selected option. */
  --lgs1920-autocomplete-option-selected-background: var(--wa-color-brand-fill-loud);
  /* Use the matching on-color text for contrast. */
  --lgs1920-autocomplete-option-selected-color: var(--wa-color-brand-on-loud);
  /* Tint option icons with the current brand hue. */
  --lgs1920-autocomplete-option-icon-color: var(--wa-color-brand-on-quiet);
  /* Color the input outline and focus state with the chosen brand hue. */
  --wa-form-control-border-color: var(--wa-color-brand-border-loud);
  --wa-form-control-activated-color: var(--wa-color-brand-fill-loud);
  /* Tint the filled input surface with the chosen brand hue. */
  --wa-color-neutral-fill-quiet: var(--wa-color-brand-fill-quiet);
  /* Keep the input placeholder within the chosen brand palette. */
  --lgs1920-autocomplete-placeholder-color: var(--wa-color-brand-on-quiet);
}</code></pre>
                    <p class="eyebrow">JavaScript</p>
                    <pre data-language="JavaScript"><code><span class="token-keyword">const</span> field = document.querySelector(<span class="token-string">'#brand-color-autocomplete'</span>)
<span class="token-keyword">const</span> root = document.documentElement
<span class="token-keyword">const</span> brandControl = document.querySelector(<span class="token-string">'#brand-control'</span>)
<span class="token-keyword">const</span> preview = document.querySelector(<span class="token-string">'#brand-color-preview'</span>)
<span class="token-keyword">const</span> previewName = document.querySelector(<span class="token-string">'#brand-color-preview-name'</span>)
<span class="token-keyword">const</span> hues = [<span class="token-string">'red'</span>, <span class="token-string">'orange'</span>, <span class="token-string">'yellow'</span>, <span class="token-string">'green'</span>, <span class="token-string">'cyan'</span>, <span class="token-string">'blue'</span>, <span class="token-string">'indigo'</span>, <span class="token-string">'purple'</span>, <span class="token-string">'pink'</span>, <span class="token-string">'gray'</span>]
field.options = hues.map(hue <span class="token-operator">=&gt;</span> ({<span class="token-property">value</span>: hue, <span class="token-property">label</span>: hue}))
<span class="token-keyword">const</span> updatePreview = option <span class="token-operator">=&gt;</span> {
  <span class="token-keyword">if</span> (!option) <span class="token-keyword">return</span>
  <span class="token-keyword">const</span> brandClasses = hues.map(hue <span class="token-operator">=&gt;</span> <span class="token-string">'wa-brand-'</span> + hue)
  root.classList.remove(...brandClasses)
  root.classList.add(<span class="token-string">'wa-brand-'</span> + option.value)
