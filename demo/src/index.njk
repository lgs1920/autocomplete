<span class="token-punctuation">&lt;</span><span class="token-tag">script</span> <span class="token-attribute">type</span>=<span class="token-attribute-value">"module"</span> <span class="token-attribute">src</span>=<span class="token-attribute-value">"./main.js"</span><span class="token-punctuation">&gt;&lt;/</span><span class="token-tag">script</span><span class="token-punctuation">&gt;</span></code></pre>
