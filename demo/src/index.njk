            <div>
                <p class="eyebrow">JavaScript · main.js</p>
                <pre data-language="JavaScript"><code><span class="token-keyword">import</span> <span class="token-string">'@awesome.me/webawesome/dist/styles/webawesome.css'</span>
<span class="token-keyword">import</span> <span class="token-string">'@awesome.me/webawesome/dist/styles/themes/default.css'</span>
<span class="token-keyword">import</span> <span class="token-string">'@lgs1920/autocomplete'</span>

<span class="token-keyword">const</span> field = document.querySelector(<span class="token-string">'#city-search'</span>)
field.options = [
  ...field.options,
  {<span class="token-property">value</span>: <span class="token-string">'lyon'</span>, <span class="token-property">label</span>: <span class="token-string">'Lyon'</span>, <span class="token-property">icon</span>: <span class="token-string">'location-dot'</span>, <span class="token-property">department</span>: <span class="token-string">'69'</span>, <span class="token-property">region</span>: <span class="token-string">'Auvergne-Rhône-Alpes'</span>},
]
field.persistence = {<span class="token-property">id</span>: <span class="token-string">'city-search'</span>, <span class="token-property">limit</span>: <span class="token-number">5</span>} <span class="token-comment">// Optional: show recent choices on an empty query.</span>

<span class="token-keyword">const</span> form = document.querySelector(<span class="token-string">'#city-form'</span>)
<span class="token-keyword">const</span> output = document.querySelector(<span class="token-string">'#city-result'</span>)

field.addEventListener(<span class="token-string">'wa-select'</span>, event <span class="token-operator">=&gt;</span> {
  <span class="token-keyword">const</span> {option} = event.detail
  output.textContent = <span class="token-string">`${option.label} — ${option.department}, ${option.region}`</span>
})

form.addEventListener(<span class="token-string">'submit'</span>, event <span class="token-operator">=&gt;</span> {
  event.preventDefault()
  <span class="token-keyword">const</span> value = <span class="token-keyword">new</span> FormData(form).get(<span class="token-string">'city'</span>)
  output.textContent = value ? <span class="token-string">`Submitted city value: ${value}`</span> : <span class="token-string">'Choose a city first.'</span>
})</code></pre>
